# =============================================================================
# Receipta Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values before starting the server.
#
#   cp .env.example .env
#
# NEVER commit .env to version control. It is listed in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — server will refuse to start if these are missing or invalid
# -----------------------------------------------------------------------------

# Secret used to sign and verify JWTs.
# Must be at least 32 characters. Use a cryptographically random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# PostgreSQL connection string.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# For local development with the default postgres user:
#   postgres://postgres:postgres@localhost:5432/receipta
DATABASE_URL=postgres://postgres:postgres@localhost:5432/receipta

# -----------------------------------------------------------------------------
# REQUIRED IN PRODUCTION — warns in development if unset
# -----------------------------------------------------------------------------

# Deployed Soroban contract ID (C... address).
CONTRACT_ID=

# Stellar Soroban RPC endpoint.
# Testnet default is pre-filled; override for mainnet or a custom node.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# -----------------------------------------------------------------------------
# OPTIONAL — sensible defaults are used when not set
# -----------------------------------------------------------------------------

# Port the Express server listens on.
PORT=3001

# Node environment: development | test | production
NODE_ENV=development

# Allowed frontend origin for CORS (must match the Next.js dev server or prod domain).
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# SECURITY — request body size limit
# -----------------------------------------------------------------------------

# Maximum size of a JSON or URL-encoded request body.
# Requests exceeding this limit are rejected with HTTP 413 Payload Too Large.
# Express byte-string format: "16kb", "1mb", etc.
# Default: 16kb — sufficient for all legitimate API payloads.
BODY_SIZE_LIMIT=16kb
